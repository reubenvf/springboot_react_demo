{
  "info": {
    "name": "SpringBootDemo API",
    "description": "Collection for testing Spring Boot CRUD + pagination + nested external API calls",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create Customer",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Alice Johnson\",\n  \"email\": \"alice@example.com\",\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/customers",
          "host": ["{{baseUrl}}"],
          "path": ["api", "customers"]
        }
      },
      "response": []
    },
    {
      "name": "Get Customer By Id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/customers/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "customers", "1"]
        }
      },
      "response": []
    },
    {
      "name": "Update Customer",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Alice Updated\",\n  \"email\": \"alice.updated@example.com\",\n  \"status\": \"INACTIVE\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/customers/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "customers", "1"]
        }
      },
      "response": []
    },
    {
      "name": "Get Customers (Paginated)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/customers?page=0&size=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "customers"],
          "query": [
            { "key": "page", "value": "0" },
            { "key": "size", "value": "10" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Nested Third-Party API Call",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/external-demo?page=1&size=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "external-demo"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "size", "value": "10" }
          ]
        }
      },
      "response": []
    }
  ]
}
